@model NetCoreAI.Project2_ApiConsumption.Dtos.UpdateCustomerDto

@{
    Layout = null;
}

<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

<form method="post" asp-action="UpdateCustomer" asp-controller="Customer">
    <div class="container">
        <br /><br />
        <input type="hidden" asp-for="CustomerId"/>
        <label>Customer First Name</label>
        <input type="text" asp-for="CustomerFirstName" class="form-control" />
        <br />
        <label>Customer Last Name</label>
        <input type="text" asp-for="CustomerLastName" class="form-control" />
        <br />
        <label>Customer Balance</label>
        <input type="text" asp-for="CustomerBalance" class="form-control" />
        <br />
        <button class="btn btn-dark" type="submit">Update Customer</button>
    </div>
</form>