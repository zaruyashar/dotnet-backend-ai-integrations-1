@model List<NetCoreAI.Project2_ApiConsumption.Dtos.ResultCustomerDto>

@{
    Layout = null;
}

<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />


<div class="container">
    <br /><br />
    <table class="table table-bordered">
        <tr>
            <th>#</th>
            <th>Full Name</th>
            <th>Balance</th>
            <th>Delete</th>
            <th>Update</th>
        </tr>

        @foreach(var item in Model)
        {
            <tr>
                <td>@item.CustomerId</td>
                <td>@item.CustomerFirstName @item.CustomerLastName</td>
                <td>@item.CustomerBalance</td>
                <td><a href="/Customer/DeleteCustomer/@item.CustomerId" class="btn btn-outline-danger">Delete</a></td>
                <td><a href="/Customer/UpdateCustomer/@item.CustomerId" class="btn btn-outline-success">Update</a></td>
            </tr>
        }
    </table>

    <a href="/Customer/CreateCustomer" class="btn btn-primary">+ Add New</a>
</div>